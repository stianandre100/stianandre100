# Anthropic API-nøkkel
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tripletex API-tokens
# Consumer token finner du i Tripletex under Administrasjon > API-tilgang
TRIPLETEX_CONSUMER_TOKEN=your_consumer_token_here

# Employee token finner du under din brukerprofil i Tripletex
TRIPLETEX_EMPLOYEE_TOKEN=your_employee_token_here

# Bruk 'test' for sandbox-miljø, 'production' for produksjon
TRIPLETEX_ENV=test
